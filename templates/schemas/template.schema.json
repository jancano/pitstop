{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pitstop project template version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "author", "license", "category", "language", "buildSystem", "parameters", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/label" },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$" },
    "name": { "$ref": "#/$defs/label" },
    "description": { "$ref": "#/$defs/label" },
    "author": { "$ref": "#/$defs/label" },
    "license": { "$ref": "#/$defs/label" },
    "category": { "$ref": "#/$defs/label" },
    "language": { "$ref": "#/$defs/label" },
    "buildSystem": { "$ref": "#/$defs/label" },
    "icon": { "$ref": "#/$defs/label" },
    "tags": { "$ref": "#/$defs/labels" },
    "requiresCapabilities": { "$ref": "#/$defs/labels" },
    "minimumStandardOrder": { "type": "integer" },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1 },
    "labels": { "type": "array", "items": { "$ref": "#/$defs/label" } },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "equalsValue"],
      "properties": {
        "parameter": { "$ref": "#/$defs/label" },
        "equalsValue": { "type": "string" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["string", "boolean", "choice", "languageStandard", "toolchain", "directory", "integer"] },
        "default": { "type": ["string", "boolean", "integer", "null"] },
        "required": { "type": "boolean" },
        "help": { "type": "string" },
        "choices": { "$ref": "#/$defs/labels" },
        "validation": { "enum": ["none", "fileName", "targetName", "identifier", "moduleName"] },
        "requiresCapability": { "$ref": "#/$defs/label" },
        "requiresStandardCapability": { "$ref": "#/$defs/label" },
        "when": { "$ref": "#/$defs/condition" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination"],
      "properties": {
        "source": { "$ref": "#/$defs/label" },
        "destination": { "$ref": "#/$defs/label" },
        "binary": { "type": "boolean" },
        "when": { "$ref": "#/$defs/condition" }
      }
    }
  }
}
