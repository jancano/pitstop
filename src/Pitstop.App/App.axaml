<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Pitstop.App"
             x:Class="Pitstop.App.App"
             Name="Pitstop"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Pitstop/Theme/Tokens.axaml" />
                <!-- Fluent's own keys as the tokens of whichever theme is in force (Themes lays any other theme after these). -->
                <app:FluentKeys />
                <ResourceInclude Source="avares://Pitstop/Theme/Icons.axaml" />
                <ResourceInclude Source="avares://Pitstop/Theme/FileIconSet.axaml" />
                <ResourceInclude Source="avares://Pitstop/Theme/ControlThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Pitstop/Theme/Shell.axaml" />
    </Application.Styles>
</Application>
