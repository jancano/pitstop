<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSBuild's evaluation of the open folder's projects, in a process of its own: MSBuild needs the JIT and the
       installed SDK's own assemblies, which MSBuildLocator finds by the folder's global.json, and none of it belongs in
       the UI's process. It runs on the runtime Passenger runs on (Passenger's helper host), and for an SDK newer than that
       on the machine's newest, so whichever SDK the folder picks can load, and carries MSBuildLocator alone: MSBuild is
       compiled against, never copied. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The oldest runtime it needs, Roslyn's server's: on the machine's, it rolls forward to the newest there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pitstop.Host</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
    <!-- PathNames' own calls to the system (realpath, GetFinalPathNameByHandle). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled against at the oldest MSBuild an SDK it may load has (8.0.4xx's); the SDK's own assemblies run. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pitstop.Core's paths, a project's own folders and the names it reads them by, its reader of JSON lines, its
         pooled buffer and MSBuild's names, compiled in since its net11.0 is past the host's. -->
    <Compile Include="../Pitstop.Core/PathNames.cs" Link="PathNames.cs" />
    <!-- The Windows calls PathNames and SessionProcesses make, declared once. -->
    <Compile Include="../Pitstop.Core/Kernel32.cs" Link="Kernel32.cs" />
    <!-- How PathNames tells a link apart as a walk meets one, as the rest of Passenger does. -->
    <Compile Include="../Pitstop.Core/FileLinks.cs" Link="FileLinks.cs" />
    <!-- How long a session's end waits for the processes it started to be gone. -->
    <Compile Include="../Pitstop.Core/Deadline.cs" Link="Deadline.cs" />
    <Compile Include="../Pitstop.Core/PathComparer.cs" Link="PathComparer.cs" />
    <Compile Include="../Pitstop.Core/ProjectFolders.cs" Link="ProjectFolders.cs" />
    <Compile Include="../Pitstop.Core/FolderNames.cs" Link="FolderNames.cs" />
    <Compile Include="../Pitstop.Core/JsonLines.cs" Link="JsonLines.cs" />
    <Compile Include="../Pitstop.Core/PooledBytes.cs" Link="PooledBytes.cs" />
    <Compile Include="../Pitstop.Core/MSBuildNames.cs" Link="MSBuildNames.cs" />
    <!-- .NET's frameworks' names, by which the host reads an evaluation's framework. -->
    <Compile Include="../Pitstop.Core/FrameworkNames.cs" Link="FrameworkNames.cs" />
    <!-- A C# name's characters, as a program's first member is read by them (ProgramFiles). -->
    <Compile Include="../Pitstop.Core/CSharpNames.cs" Link="CSharpNames.cs" />
    <!-- Where a .NET keeps its workloads, the user's own folder too, whose imports are no project's own. -->
    <Compile Include="../Pitstop.Core/WorkloadFolders.cs" Link="WorkloadFolders.cs" />
    <!-- NuGet's layout of a package folder, by which a package's own build file tells its files from a project's. -->
    <Compile Include="../Pitstop.Core/PackageLayout.cs" Link="PackageLayout.cs" />
    <!-- A parallel loop's threads of its own, so the host's other requests never wait for an evaluation's loop to end. -->
    <Compile Include="../Pitstop.Core/ApartScheduler.cs" Link="ApartScheduler.cs" />
    <Compile Include="../Pitstop.Core/ApartThreads.cs" Link="ApartThreads.cs" />
  </ItemGroup>

  <!-- MSBuild's own dependencies come from the SDK with it: copied here, an older one would be loaded in their place. -->
  <Target Name="CarryOnlyTheLocator" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' != 'Microsoft.Build.Locator'" />
    </ItemGroup>
  </Target>
</Project>
