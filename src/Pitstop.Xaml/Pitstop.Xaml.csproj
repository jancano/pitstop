<Project Sdk="Microsoft.NET.Sdk">
  <!-- XAML with no UI, Passenger's own and shared by its dialects (Avalonia's and WPF's): XML with positions, xmlns
       to CLR namespaces, the types a project's assemblies and its own C# declare (System.Reflection.Metadata, Roslyn's
       parser), markup extensions, resources, and what a XAML file completes, warns of and goes to from that. -->
  <PropertyGroup>
    <RootNamespace>Pitstop.Xaml</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Pitstop.Languages/CSharp/CodeBrackets.cs" Link="Metadata/CodeBrackets.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../Pitstop.Core/Pitstop.Core.csproj" />
    <!-- The package cache a project's restores use, as its nuget.config names it, for a project not restored yet. -->
    <ProjectReference Include="../Pitstop.Packages/Pitstop.Packages.csproj" />
    <ProjectReference Include="../Pitstop.Text/Pitstop.Text.csproj" />
  </ItemGroup>
</Project>
