<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the UI knows of a language before any language server answers: colour from a parser
       that runs in-process, off the UI thread. -->
  <PropertyGroup>
    <RootNamespace>Pitstop.Languages</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Tint" />
    <ProjectReference Include="../Pitstop.Editor/Pitstop.Editor.csproj" />
    <ProjectReference Include="../Pitstop.Lsp/Pitstop.Lsp.csproj" />
    <ProjectReference Include="../Pitstop.Text/Pitstop.Text.csproj" />
    <!-- A .feature file's folds, from Gherkin's own reading of it (Gherkin/FeatureReading). -->
    <ProjectReference Include="../Pitstop.Workspace/Pitstop.Workspace.csproj" />
  </ItemGroup>

  <!-- What C#'s refactorings refuse in the words they are asked, one rule for the extension and the dialogs, compiled here
       beside the CodeBrackets it reads through. -->
  <ItemGroup>
    <Compile Include="../Pitstop.Roslyn.Extension/RefactoringChecks.cs" Link="CSharp/RefactoringChecks.cs" />
  </ItemGroup>

  <!-- The services an Aspire AppHost names, one reader for the extension and the window's syntax reads. -->
  <ItemGroup>
    <Compile Include="../Pitstop.Roslyn.Extension/AspireServices.cs" Link="CSharp/AspireServices.cs" />
  </ItemGroup>

  <!-- VS Code's TextMate grammars and dotnet/roslyn's Razor and C# ones, unchanged (THIRD_PARTY_NOTICES.md says where each
       came from), read by their file name. -->
  <ItemGroup>
    <EmbeddedResource Include="TextMate/Grammars/*.json" LogicalName="Grammars/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
