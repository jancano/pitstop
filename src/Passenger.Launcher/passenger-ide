#!/bin/sh
# pitstop-ide on macOS: runs the Pitstop this script is carried by, through a link to it too, with everything it is
# given: a folder, a solution or a file, and Pitstop's flags. Pitstop's app is beside the script's bin folder in a
# build, and in Contents/MacOS where the app's bundle carries the script in Contents/Resources/bin.
self=$(readlink -f "$0") || self=$0
bin=$(dirname "$self")
for app in "$bin/.." "$bin/../../MacOS"; do
    if [ -x "$app/Pitstop" ] && [ -f "$app/Pitstop.dll" ]; then
        exec "$(cd "$app" && pwd -P)/Pitstop" "$@"
    fi
done
echo "pitstop-ide: no Pitstop is beside $self: add the command again from Pitstop's Tools menu" >&2
exit 127
