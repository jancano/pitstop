<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version control with no UI: Git through its command line, the log's graph, a file's diff and the three-way merge.
       No Avalonia, so the boundary is the project's own. -->
  <PropertyGroup>
    <RootNamespace>Pitstop.Vcs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The merge window reads a diff's places as the diff does (FileDiff.Place). -->
    <InternalsVisibleTo Include="Pitstop" />
    <InternalsVisibleTo Include="Pitstop.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pitstop.Core/Pitstop.Core.csproj" />
    <ProjectReference Include="../Pitstop.Text/Pitstop.Text.csproj" />
  </ItemGroup>
</Project>
